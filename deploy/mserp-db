#!/usr/bin/env python3
"""Route root-owned database operations to the active application's database."""
import configparser
import hashlib
import json
import os
from pathlib import Path
import shlex
import stat
import sys
from urllib.parse import urlsplit, unquote

ENV_FILE = Path('/etc/mserp/mserp.env')
ADMIN_FILE = Path('/etc/mserp/database-admin.conf')
LOCAL_ID = 'local:mserp'


def secure_read(path, owner=0, private=False):
    info = path.lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_uid != owner or info.st_mode & (0o077 if private else 0o027):
        raise ValueError('Unsafe database configuration permissions')
    return path.read_text()


def destination(env_file=ENV_FILE, admin_file=ADMIN_FILE, owner=0):
    values = []
    for line in secure_read(env_file, owner).splitlines():
        line = line.strip()
        if line.startswith('DATABASE_URL='):
            tokens = shlex.split(line[len('DATABASE_URL='):], comments=False)
            if len(tokens) != 1:
                raise ValueError('Invalid database configuration')
            values.append(tokens[0])
    if len(values) != 1:
        raise ValueError('Exactly one DATABASE_URL is required')
    url = urlsplit(values[0])
    if url.scheme not in ('postgres', 'postgresql') or not url.hostname or unquote(url.path) != '/mserp':
        raise ValueError('Unsupported database destination')
    target = (url.hostname.lower(), url.port or 5432, 'mserp')
    if target[0] in ('localhost', '127.0.0.1', '::1') and target[1] == 5432:
        return LOCAL_ID, None
    raw = secure_read(admin_file, owner, private=True)
    # libpq does not accept ConfigParser's default "key = value" output.
    # Reject it during preflight, before a migration changes runtime routing.
    for line in raw.splitlines():
        if '=' in line and not line.lstrip().startswith(('#', ';')):
            key = line.split('=', 1)[0]
            if key != key.rstrip():
                raise ValueError('libpq service keys must directly precede equals')
    config = configparser.ConfigParser(interpolation=None)
    config.read_string(raw)
    section = config['mserp']
    if (section['host'].lower(), int(section['port']), section['dbname']) != target:
        raise ValueError('Administrator and application database destinations differ')
    if section.get('sslmode') != 'verify-full' or not section.get('sslrootcert'):
        raise ValueError('Managed database requires verified TLS')
    if not section.get('user') or not section.get('password'):
        raise ValueError('Administrator credentials are missing')
    if set(section) - {'host', 'port', 'dbname', 'user', 'password', 'sslmode', 'sslrootcert', 'connect_timeout'}:
        raise ValueError('Unsupported administrator connection option')
    identity = 'remote:' + hashlib.sha256(json.dumps(target).encode()).hexdigest()
    return identity, str(admin_file)


def command(argv, service_file):
    if not argv or argv[0] not in ('psql', 'pg_dump'):
        raise ValueError('Only psql and pg_dump are supported')
    # These root-owned callers always name mserp explicitly. Never permit a
    # connection URL or alternate host/user/database to override validation.
    args = [argv[0]]
    needs_value = False
    for arg in argv[1:]:
        if needs_value:
            args.append(arg)
            needs_value = False
            continue
        if arg == '--dbname=mserp':
            continue
        if not arg.startswith('-') or arg.startswith(('-h', '-p', '-U', '-d', '--host', '--port', '--username', '--dbname')):
            raise ValueError('Connection overrides are forbidden')
        args.append(arg)
        needs_value = arg in ('-c', '--command', '-f', '--file', '-v', '--set', '-o', '--output', '-P', '--pset', '-F', '--field-separator')
    if needs_value:
        raise ValueError('Missing database command option value')
    environment = {k: v for k, v in os.environ.items() if not k.startswith('PG')}
    if service_file:
        environment.update(PGSERVICEFILE=service_file, PGSERVICE='mserp', PGCONNECT_TIMEOUT='10')
    else:
        args = ['runuser', '-u', 'postgres', '--'] + args + ['--dbname=mserp']
    return args, environment


def main():
    if os.geteuid() != 0:
        raise ValueError('Run as root')
    identity, service_file = destination()
    if sys.argv[1:] == ['identity']:
        print(identity)
        return
    args, environment = command(sys.argv[1:], service_file)
    os.execvpe(args[0], args, environment)


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, KeyError, configparser.Error):
        # Never render parser exceptions: they may include credential text.
        print('Database routing failed; check root-owned database configuration', file=sys.stderr)
        sys.exit(1)
