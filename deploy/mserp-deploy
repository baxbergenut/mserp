#!/usr/bin/env bash
set -euo pipefail

release_id=${1:-}
expected_checksum=${2:-}
incoming_root=/var/lib/mserp-deploy/incoming
release_root=/opt/mserp/releases
current_link=/opt/mserp/current
backup_helper=/usr/local/sbin/mserp-backup

if [[ ! $release_id =~ ^[0-9a-f]{40}$ ]]; then
    echo "release id must be a 40-character lowercase Git commit SHA" >&2
    exit 2
fi
if [[ ! $expected_checksum =~ ^[0-9a-f]{64}$ ]]; then
    echo "checksum must be a lowercase SHA-256 digest" >&2
    exit 2
fi

exec 9>/run/lock/mserp-deploy.lock
if ! flock -n 9; then
    echo "another MSERP deployment is already running" >&2
    exit 1
fi

incoming_archive=$incoming_root/$release_id.tar.gz
release_dir=$release_root/$release_id
staged_archive=
extract_dir=
cutover_started=false
deployment_complete=false
expense_exporter_stopped=false
fleet_review_stopped=false
previous_release=$(readlink -f "$current_link" 2>/dev/null || true)
permissions_migration=112_permissions_v2.sql
manager_verification_migration=151_retire_expense_manager_verification.sql
accounting_cutover_migration=160_accounting_cutover.sql
accounting_retirement_migration=161_retire_accounting_cutover.sql
status_colors_migration=171_status_colors.sql
status_palette_rollback_migration=172_restore_status_board_palette.sql
payroll_cost_start_migration=173_payroll_cost_start.sql
expense_balance_migration=176_expense_balance_corrections.sql
payroll_revision_migration=180_payroll_revision_triggers.sql
payroll_load_revision_migration=181_payroll_load_revision.sql
payroll_projection_migration=182_payroll_projections.sql
payroll_telemetry_migration=183_payroll_telemetry_classification.sql
payroll_operational_migration=184_payroll_operational_sources.sql
payroll_shared_migration=185_payroll_shared_dependencies.sql
expense_verification_migration=186_expense_verification_metadata.sql
load_availability_migration=187_load_source_availability.sql
board_operational_migration=188_status_board_operational.sql
payroll_storage_migration=189_payroll_current_storage.sql
expense_archive_migration=190_expense_receipt_archives.sql
pti_operational_migration=191_payroll_pti_classification.sql
unrelated_payroll_migration=192_payroll_unrelated_sources.sql
company_expense_migration=193_payroll_unassigned_company_expenses.sql
driver_gross_migration=195_datatruck_driver_gross.sql
modified_sync_migration=196_datatruck_modified_sync.sql
routing_usage_migration=197_board_route_usage.sql
expense_drafts_migration=198_payroll_expense_drafts.sql
accessorial_expenses_migration=203_accessorial_expenses.sql
escrow_settlement_migration=204_driver_pay_escrow_settlement.sql
gross_planning_migration=206_gross_board_planning_entries.sql
escrow_balance_migration=209_escrow_balance_reductions.sql
escrow_adjustment_migration=210_escrow_balance_adjustments.sql
gross_week_lock_migration=211_gross_board_week_lock.sql

# BEGIN BACKUP POLICY
collect_pending_migrations() {
    local directory=$1 ledger_exists applied migration name
    pending_migrations=()
    ledger_exists=$(runuser -u postgres -- psql -X -At -v ON_ERROR_STOP=1 --dbname=mserp -c "SELECT to_regclass('public.schema_migrations') IS NOT NULL") || return 1
    case $ledger_exists in
        t) applied=$(runuser -u postgres -- psql -X -At -v ON_ERROR_STOP=1 --dbname=mserp -c 'SELECT version FROM public.schema_migrations ORDER BY version') || return 1 ;;
        f) applied= ;;
        *) echo 'could not determine migration ledger state' >&2; return 1 ;;
    esac
    shopt -s nullglob
    for migration in "$directory"/[0-9][0-9][0-9]_*.sql; do
        name=$(basename "$migration")
        if [[ ! $name =~ ^[0-9]{3}_[a-z0-9_]+\.sql$ ]]; then
            echo "invalid migration filename: $name" >&2
            return 1
        fi
        if ! grep -Fxq -- "$name" <<< "$applied"; then pending_migrations+=("$name"); fi
    done
}

prepare_release_backup() {
    if (( ${#pending_migrations[@]} > 0 )); then
        echo "pending database migrations: ${#pending_migrations[@]}; creating a fresh verified backup"
        backup_file=$("$backup_helper" --create --label "$release_id") || return 1
    else
        if ! systemctl is-enabled --quiet mserp-backup.timer || ! systemctl is-active --quiet mserp-backup.timer; then
            echo 'scheduled database backup timer must be enabled and active before skipping a deployment backup' >&2
            return 1
        fi
        if systemctl is-failed --quiet mserp-backup.service; then
            echo 'scheduled database backup service failed; repair it before deploying' >&2
            return 1
        fi
        if [[ $(systemctl show --property=LoadState --value mserp-backup.service) != loaded ]]; then
            echo 'scheduled database backup service is missing or unavailable' >&2
            return 1
        fi
        backup_file=$("$backup_helper" --check) || return 1
        echo 'no pending database migrations; reusing the recent verified scheduled backup'
    fi
    echo "$backup_file"
}
# END BACKUP POLICY

compatible_release() {
    [[ -n $1 && -d $1 ]] || return 1
    local gross_week_lock
    gross_week_lock=$(runuser -u postgres -- psql -X -At -v ON_ERROR_STOP=1 --dbname=mserp -c "SELECT to_regclass('public.gross_board_week_locks') IS NOT NULL") || return 1
    if [[ $gross_week_lock == t ]]; then
        [[ $("$1/backend/mserp-api" -gross-board-week-lock-capability 2>/dev/null) == gross-board-week-lock-v1 ]] || return 1
    elif [[ $gross_week_lock != f ]]; then return 1; fi
    local escrow_adjustment
    escrow_adjustment=$(runuser -u postgres -- psql -X -At -v ON_ERROR_STOP=1 --dbname=mserp -c "SELECT EXISTS(SELECT 1 FROM information_schema.table_constraints WHERE table_schema='public' AND table_name='driver_escrow_releases' AND constraint_name='escrow_balance_movement_check')") || return 1
    if [[ $escrow_adjustment == t ]]; then
        [[ $("$1/backend/mserp-api" -escrow-balance-adjustments-capability 2>/dev/null) == escrow-balance-adjustments-v1 ]] || return 1
    elif [[ $escrow_adjustment != f ]]; then return 1; fi
    local escrow_balance
    escrow_balance=$(runuser -u postgres -- psql -X -At -v ON_ERROR_STOP=1 --dbname=mserp -c "SELECT EXISTS(SELECT 1 FROM information_schema.columns WHERE table_schema='public' AND table_name='driver_escrow_releases' AND column_name='correction_reason')") || return 1
    if [[ $escrow_balance == t ]]; then
        [[ $("$1/backend/mserp-api" -escrow-balance-reductions-capability 2>/dev/null) == escrow-balance-reductions-v1 ]] || return 1
    elif [[ $escrow_balance != f ]]; then return 1; fi
    local gross_planning
    gross_planning=$(runuser -u postgres -- psql -X -At -v ON_ERROR_STOP=1 --dbname=mserp -c "SELECT to_regclass('public.gross_board_planning_entries') IS NOT NULL") || return 1
    if [[ $gross_planning == t ]]; then
        [[ $("$1/backend/mserp-api" -gross-board-planning-capability 2>/dev/null) == gross-board-planning-v1 ]] || return 1
    elif [[ $gross_planning != f ]]; then return 1; fi
    local accessorial_expenses
    accessorial_expenses=$(runuser -u postgres -- psql -X -At -v ON_ERROR_STOP=1 --dbname=mserp -c "SELECT to_regclass('public.expense_accessorial_payments') IS NOT NULL") || return 1
    if [[ $accessorial_expenses == t ]]; then
        [[ $("$1/backend/mserp-api" -accessorial-expenses-capability 2>/dev/null) == accessorial-expenses-v1 ]] || return 1
    elif [[ $accessorial_expenses != f ]]; then return 1; fi
    local escrow_settlement
    escrow_settlement=$(runuser -u postgres -- psql -X -At -v ON_ERROR_STOP=1 --dbname=mserp -c "SELECT EXISTS(SELECT 1 FROM information_schema.columns WHERE table_schema='public' AND table_name='driver_pay_weeks' AND column_name='escrow_draft')") || return 1
    if [[ $escrow_settlement == t ]]; then
        [[ $("$1/backend/mserp-api" -driver-pay-escrow-capability 2>/dev/null) == driver-pay-escrow-v1 ]] || return 1
    elif [[ $escrow_settlement != f ]]; then return 1; fi
    local expense_drafts
    expense_drafts=$(runuser -u postgres -- psql -X -At -v ON_ERROR_STOP=1 --dbname=mserp -c "SELECT EXISTS(SELECT 1 FROM information_schema.columns WHERE table_schema='public' AND table_name='driver_pay_weeks' AND column_name='expense_choices')") || return 1
    if [[ $expense_drafts == t ]]; then
        [[ $("$1/backend/mserp-api" -payroll-expense-drafts-capability 2>/dev/null) == payroll-expense-drafts-v1 ]] || return 1
        local scale_carry
        scale_carry=$(runuser -u postgres -- psql -X -At -v ON_ERROR_STOP=1 --dbname=mserp -c "
            SELECT EXISTS(
                SELECT 1 FROM (
                    SELECT week_start,report FROM public.payroll_settlements WHERE finalized
                    UNION ALL SELECT week_start,report FROM public.investor_pay_weeks WHERE finalized
                ) f
                CROSS JOIN LATERAL jsonb_array_elements(CASE WHEN jsonb_typeof(f.report->'autoCharges')='array' THEN f.report->'autoCharges' ELSE '[]'::jsonb END) c
                JOIN public.weighmytruck_transactions t ON c->>'source'='weighmytruck:'||t.id
                WHERE t.transaction_date NOT BETWEEN f.week_start AND f.week_start+6
            )") || return 1
        if [[ $scale_carry == t ]]; then
            [[ $("$1/backend/mserp-api" -payroll-scale-carry-capability 2>/dev/null) == payroll-scale-carry-v1 ]] || return 1
        elif [[ $scale_carry != f ]]; then return 1; fi
        local scale_partial
        scale_partial=$(runuser -u postgres -- psql -X -At -v ON_ERROR_STOP=1 --dbname=mserp -c "
            SELECT EXISTS(
                SELECT 1 FROM (
                    SELECT report FROM public.payroll_settlements WHERE finalized
                    UNION ALL SELECT report FROM public.investor_pay_weeks WHERE finalized
                ) f
                CROSS JOIN LATERAL jsonb_array_elements(CASE WHEN jsonb_typeof(f.report->'autoCharges')='array' THEN f.report->'autoCharges' ELSE '[]'::jsonb END) c
                WHERE c->>'source' LIKE 'weighmytruck:%' AND c ? 'scaleOriginalAmount'
                  AND (c->>'scaleOriginalAmount')::numeric<>(c->>'amount')::numeric
            ) OR EXISTS(
                SELECT 1 FROM public.driver_pay_weeks w WHERE jsonb_path_exists(to_jsonb(w)->'scale_deductions', '$.* ? (@ != \"0.00\")')
            ) OR EXISTS(
                SELECT 1 FROM public.investor_pay_weeks w WHERE jsonb_path_exists(w.edits->'scaleDeductions', '$.* ? (@ != \"0.00\")')
            )") || return 1
        if [[ $scale_partial == t ]]; then
            [[ $("$1/backend/mserp-api" -payroll-scale-partial-capability 2>/dev/null) == payroll-scale-partial-v1 ]] || return 1
        elif [[ $scale_partial != f ]]; then return 1; fi
    elif [[ $expense_drafts != f ]]; then return 1; fi
    local applied manager_removed accounting_installed cost_start_installed cost_start_active balance_installed balance_active projection_installed projection_active telemetry_excluded operational_excluded shared_dependencies verification_metadata load_availability board_operational pti_operational unrelated_payroll payroll_current
    local routing_usage
    routing_usage=$(runuser -u postgres -- psql -X -At -v ON_ERROR_STOP=1 --dbname=mserp -c "SELECT to_regclass('public.board_route_usage') IS NOT NULL") || return 1
    if [[ $routing_usage == t ]]; then
        [[ $("$1/backend/mserp-api" -board-routing-usage-capability 2>/dev/null) == board-routing-usage-v1 ]] || return 1
    elif [[ $routing_usage != f ]]; then return 1; fi
    # Detect the committed schema even if recording the migration ledger failed.
    applied=$(runuser -u postgres -- psql -X -At -v ON_ERROR_STOP=1 --dbname=mserp -c "SELECT EXISTS(SELECT 1 FROM information_schema.columns WHERE table_schema='public' AND table_name='files' AND column_name='uploaded_by')") || return 1
    [[ $applied == f ]] || { [[ $applied == t ]] && [[ -f $1/migrations/$permissions_migration ]]; } || return 1
    manager_removed=$(runuser -u postgres -- psql -X -At -v ON_ERROR_STOP=1 --dbname=mserp -c "SELECT NOT EXISTS(SELECT 1 FROM information_schema.columns WHERE table_schema='public' AND table_name='expenses' AND column_name='manager_verified')") || return 1
    [[ $manager_removed == f ]] || { [[ $manager_removed == t ]] && [[ -f $1/migrations/$manager_verification_migration ]]; } || return 1
    accounting_installed=$(runuser -u postgres -- psql -X -At -v ON_ERROR_STOP=1 --dbname=mserp -c "SELECT to_regclass('public.accounting_cutover') IS NOT NULL") || return 1
    [[ $accounting_installed == f ]] || { [[ $accounting_installed == t ]] && [[ -f $1/migrations/$accounting_cutover_migration ]]; } || return 1
    balance_installed=$(runuser -u postgres -- psql -X -At -v ON_ERROR_STOP=1 --dbname=mserp -c "SELECT to_regclass('public.expense_balance_corrections') IS NOT NULL") || return 1
    if [[ $balance_installed == t ]]; then
        balance_active=$(runuser -u postgres -- psql -X -At -v ON_ERROR_STOP=1 --dbname=mserp -c "SELECT EXISTS(SELECT 1 FROM public.expense_balance_corrections)") || return 1
        [[ $balance_active == f ]] || { [[ $balance_active == t ]] && [[ -f $1/migrations/$expense_balance_migration ]]; } || return 1
    elif [[ $balance_installed != f ]]; then
        return 1
    fi
    projection_installed=$(runuser -u postgres -- psql -X -At -v ON_ERROR_STOP=1 --dbname=mserp -c "SELECT to_regclass('public.payroll_projection_control') IS NOT NULL") || return 1
    if [[ $projection_installed == t ]]; then
        projection_active=$(runuser -u postgres -- psql -X -At -v ON_ERROR_STOP=1 --dbname=mserp -c "SELECT capture_enabled OR protocol_mode<>'global' FROM public.payroll_projection_control WHERE singleton") || return 1
        if [[ $projection_active == t ]]; then
            [[ -f $1/migrations/$payroll_projection_migration ]] || return 1
            [[ $("$1/backend/mserp-api" -payroll-protocol-capability) == payroll-resources-v1 ]] || return 1
        elif [[ $projection_active != f ]]; then return 1; fi
        telemetry_excluded=$(runuser -u postgres -- psql -X -At -v ON_ERROR_STOP=1 --dbname=mserp -c "SELECT EXISTS(SELECT 1 FROM public.payroll_projection_sources WHERE table_name='maintenance_telemetry' AND classification='unrelated')") || return 1
        [[ $telemetry_excluded == f ]] || { [[ $telemetry_excluded == t ]] && [[ -f $1/migrations/$payroll_telemetry_migration ]]; } || return 1
        operational_excluded=$(runuser -u postgres -- psql -X -At -v ON_ERROR_STOP=1 --dbname=mserp -c "SELECT EXISTS(SELECT 1 FROM public.payroll_projection_sources WHERE table_name='relay_driver_links' AND classification='unrelated')") || return 1
        [[ $operational_excluded == f ]] || { [[ $operational_excluded == t ]] && [[ -f $1/migrations/$payroll_operational_migration ]]; } || return 1
        shared_dependencies=$(runuser -u postgres -- psql -X -At -v ON_ERROR_STOP=1 --dbname=mserp -c "SELECT to_regclass('public.payroll_resource_dependency_sets') IS NOT NULL") || return 1
        [[ $shared_dependencies == f ]] || { [[ $shared_dependencies == t ]] && [[ -f $1/migrations/$payroll_shared_migration ]]; } || return 1
        verification_metadata=$(runuser -u postgres -- psql -X -At -v ON_ERROR_STOP=1 --dbname=mserp -c "SELECT to_regprocedure('public.payroll_expense_verification_change(jsonb,jsonb)') IS NOT NULL") || return 1
        [[ $verification_metadata == f ]] || { [[ $verification_metadata == t ]] && [[ -f $1/migrations/$expense_verification_migration ]]; } || return 1
    elif [[ $projection_installed != f ]]; then return 1; fi
    if [[ $projection_installed == t ]]; then
        board_operational=$(runuser -u postgres -- psql -X -At -v ON_ERROR_STOP=1 --dbname=mserp -c "SELECT EXISTS(SELECT 1 FROM public.payroll_projection_sources WHERE table_name='driver_board' AND classification='unrelated')") || return 1
        [[ $board_operational == f ]] || { [[ $board_operational == t ]] && [[ -f $1/migrations/$board_operational_migration ]]; } || return 1
        pti_operational=$(runuser -u postgres -- psql -X -At -v ON_ERROR_STOP=1 --dbname=mserp -c "SELECT EXISTS(SELECT 1 FROM public.payroll_projection_sources WHERE table_name='weekly_pti_rows' AND classification='unrelated')") || return 1
        [[ $pti_operational == f ]] || { [[ $pti_operational == t ]] && [[ -f $1/migrations/$pti_operational_migration ]]; } || return 1
        unrelated_payroll=$(runuser -u postgres -- psql -X -At -v ON_ERROR_STOP=1 --dbname=mserp -c "SELECT EXISTS(SELECT 1 FROM public.payroll_projection_sources WHERE table_name='feedback_posts' AND classification='unrelated')") || return 1
        [[ $unrelated_payroll == f ]] || { [[ $unrelated_payroll == t ]] && [[ -f $1/migrations/$unrelated_payroll_migration ]]; } || return 1
    fi
    load_availability=$(runuser -u postgres -- psql -X -At -v ON_ERROR_STOP=1 --dbname=mserp -c "SELECT to_regclass('public.load_source_availability') IS NOT NULL") || return 1
    [[ $load_availability == f ]] || { [[ $load_availability == t ]] && [[ -f $1/migrations/$load_availability_migration ]]; } || return 1
    payroll_current=$(runuser -u postgres -- psql -X -At -v ON_ERROR_STOP=1 --dbname=mserp -c "SELECT to_regclass('public.payroll_statement_current') IS NOT NULL") || return 1
    [[ $payroll_current == f ]] || { [[ $payroll_current == t ]] && [[ -f $1/migrations/$payroll_storage_migration ]]; } || return 1
    cost_start_installed=$(runuser -u postgres -- psql -X -At -v ON_ERROR_STOP=1 --dbname=mserp -c "SELECT to_regclass('public.payroll_cost_start') IS NOT NULL") || return 1
    [[ $cost_start_installed == f ]] && return 0
    [[ $cost_start_installed == t ]] || return 1
    cost_start_active=$(runuser -u postgres -- psql -X -At -v ON_ERROR_STOP=1 --dbname=mserp -c "SELECT EXISTS(SELECT 1 FROM public.payroll_cost_start)") || return 1
    [[ $cost_start_active == f ]] || { [[ $cost_start_active == t ]] && [[ -f $1/migrations/$payroll_cost_start_migration ]]; }
}
activate_release() {
    local target=$1
    ln -sfnT "$target" "$current_link.new"
    mv -Tf "$current_link.new" "$current_link"
}

cleanup() {
    local status=$?
    if [[ $cutover_started == true && $deployment_complete != true ]]; then
        # Stop the API before checking compatibility so a finalization cannot
        # create a cross-week collection between the check and the rollback.
        if systemctl stop mserp-api.service && compatible_release "$previous_release"; then
            activate_release "$previous_release"
            systemctl restart mserp-api.service
            if [[ $expense_exporter_stopped == true ]]; then
                systemctl restart mserp-expense-sheet.service
            fi
            if [[ $fleet_review_stopped == true ]]; then systemctl restart fleet-review.service; fi
            systemctl reload nginx
            echo "deployment failed; restored compatible application" >&2
        else
            systemctl stop mserp-api.service
            echo "deployment failed; API stopped because the previous release is schema-incompatible" >&2
        fi
    fi
    if [[ -n $staged_archive && -f $staged_archive ]]; then
        rm -f -- "$staged_archive"
    fi
    if [[ -n $extract_dir && -d $extract_dir ]]; then
        case $extract_dir in
            "$release_root"/.extract-*) rm -rf -- "$extract_dir" ;;
        esac
    fi
    return "$status"
}
trap cleanup EXIT

if [[ ! -f $incoming_archive || -L $incoming_archive ]]; then
    echo "uploaded release archive is missing or invalid" >&2
    exit 1
fi

if [[ -d $release_dir ]]; then
    if [[ $(readlink -f "$current_link" 2>/dev/null || true) == "$release_dir" ]]; then
        curl --fail --silent --show-error http://127.0.0.1:18080/readyz >/dev/null
        rm -f -- "$incoming_archive"
        echo "release $release_id is already active"
        exit 0
    fi
    echo "release directory already exists but is not active" >&2
    exit 1
fi

staged_archive=$(mktemp /var/lib/mserp-deploy/.mserp-release.XXXXXX.tar.gz)
install -o root -g root -m 0600 "$incoming_archive" "$staged_archive"
echo "$expected_checksum  $staged_archive" | sha256sum --check --status

if tar -tzf "$staged_archive" | grep -Eq '(^/|(^|/)\.\.(/|$))'; then
    echo "release archive contains an unsafe path" >&2
    exit 1
fi
if tar -tvzf "$staged_archive" | awk '$1 !~ /^[-d]/ { found=1 } END { exit !found }'; then
    echo "release archive contains links or special files" >&2
    exit 1
fi

extract_dir=$(mktemp -d "$release_root/.extract-$release_id.XXXXXX")
tar -xzf "$staged_archive" -C "$extract_dir" --no-same-owner --no-same-permissions

if [[ ! -f $extract_dir/backend/mserp-api || ! -f $extract_dir/frontend/login.html || ! -d $extract_dir/migrations ]]; then
    echo "release archive does not contain the expected MSERP artifacts" >&2
    exit 1
fi

if ! compatible_release "$extract_dir"; then
    echo "database requires a schema-compatible release" >&2
    exit 1
fi

# Resolve and validate the entire pending set before writing the migration ledger
# or leaving a release directory behind. Any lookup/backup failure stops activation.
collect_pending_migrations "$extract_dir/migrations"
# The compacting cutover must have a final, writer-quiesced recovery snapshot.
if printf '%s\n' "${pending_migrations[@]}" | grep -Fxq "$payroll_storage_migration"; then
    cutover_started=true
    systemctl stop mserp-api.service
    if systemctl is-active --quiet mserp-expense-sheet.service; then
        expense_exporter_stopped=true
        systemctl stop mserp-expense-sheet.service
    fi
    if systemctl is-active --quiet fleet-review.service; then
        fleet_review_stopped=true
        systemctl stop fleet-review.service
    fi
fi
prepare_release_backup

chown -R root:root "$extract_dir"
find "$extract_dir" -type d -exec chmod 0755 {} +
find "$extract_dir" -type f -exec chmod 0644 {} +
chown root:mserp "$extract_dir/backend/mserp-api"
chmod 0750 "$extract_dir/backend/mserp-api"
if [[ -f $extract_dir/backend/export-expense-sheet ]]; then
    chown root:mserp "$extract_dir/backend/export-expense-sheet"
    chmod 0750 "$extract_dir/backend/export-expense-sheet"
fi
if [[ -f $extract_dir/backend/reconcile-loads ]]; then
    chown root:mserp "$extract_dir/backend/reconcile-loads"
    chmod 0750 "$extract_dir/backend/reconcile-loads"
fi
mv "$extract_dir" "$release_dir"
extract_dir=

if (( ${#pending_migrations[@]} > 0 )); then
runuser -u postgres -- psql -X -v ON_ERROR_STOP=1 --dbname=mserp <<'SQL'
CREATE TABLE IF NOT EXISTS schema_migrations (
    version TEXT PRIMARY KEY,
    applied_at TIMESTAMPTZ NOT NULL DEFAULT now()
);
SQL
fi

for migration_name in "${pending_migrations[@]}"; do
    migration=$release_dir/migrations/$migration_name
	if [[ ! $migration_name =~ ^[0-9]{3}_[a-z0-9_]+\.sql$ ]]; then
		echo "invalid migration filename: $migration_name" >&2
		exit 1
	fi
	applied=$(printf "SELECT 1 FROM schema_migrations WHERE version = :'migration';\n" | \
		runuser -u postgres -- psql -X -At -v migration="$migration_name" --dbname=mserp)
    if [[ $applied == 1 ]]; then
        continue
    fi
